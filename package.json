{
  "name": "d1-portfolio-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply d1-portfolio-db --local",
    "db:remote": "wrangler d1 migrations apply d1-portfolio-db --remote",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.15",
    "tailwindcss": "^4.1.15",
    "vite": "^7.1.10",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
